# APP_URL: The public URL where UNITRACA is hosted (used for sitemap, canonical URLs, and calendar exports).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret string (min 32 chars) used to sign session cookies and tokens.
# If omitted in local development, a persistent ephemeral secret is generated automatically.
SESSION_SECRET="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_SECRET"

# DATABASE_PATH: File path for the SQLite operational & CMS database.
DATABASE_PATH="./data/unitraca.db"

# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD:
# Optional initial administrator account created only if no administrator exists yet.
# Never commit real passwords to version control.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# GEMINI_API_KEY: Optional runtime key if external AI features are configured later.
GEMINI_API_KEY=""
